#!/bin/sh

if [ -z "$1" ]; then
	echo "usage: $(basename $0) FILE"
	exit 1
fi

file=$(readlink -f $1)

if [ -z "$file" ]; then
	echo "$1: No such file" >&2
	exit 1
fi

dir=$(dirname $file)
base=${file%.*}
cd $dir || exit 1

case $file in 
	*\.c) indent -linux -sob $@ ;;
	*) echo "No formatter configured for $1" && exit 1 ;;
esac

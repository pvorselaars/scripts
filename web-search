#!/bin/bash
# web-search: type a URL to open it, or anything else to search DuckDuckGo (so its !bangs work:
# "!yt lofi", "!gh sway"). A leading "?" forces a search for things that look like URLs, e.g. "?main.py".
# `web-search --dry TEXT` prints the URL instead of opening it.

trim() {
    local text=$1
    text=${text#"${text%%[![:space:]]*}"}     # leading whitespace
    text=${text%"${text##*[![:space:]]}"}     # trailing whitespace
    echo "$text"
}

# target TEXT: the URL to open for what was typed (fails when it is empty)
target() {
    local query
    query=$(trim "$1")
    [ -n "$query" ] || return 1

    if [[ $query == \?* ]]; then
        # forced search: drop the "?" and the space after it
        query=${query#\?}
        query=${query#"${query%%[![:space:]]*}"}
    elif [[ $query =~ ^[A-Za-z][A-Za-z0-9+.-]*:// ]]; then
        # already a URL with a scheme
        echo "$query"
        return
    elif [[ $query =~ ^(localhost|[0-9]{1,3}(\.[0-9]{1,3}){3})(:[0-9]+)?([/?#]|$) ]]; then
        # localhost or an IP address, optionally with a port
        echo "http://$query"
        return
    elif [[ $query =~ ^[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+(:[0-9]+)?([/?#]|$) ]] && [[ $query != *" "* ]]; then
        # looks like a domain name
        echo "https://$query"
        return
    fi

    echo "https://duckduckgo.com/?q=$(printf '%s' "$query" | jq -sRr @uri)"
}

if [ "$1" = --dry ]; then
    target "$2"
    exit
fi

input=$(fuzzel --dmenu --prompt-only '󰖟 ' --width 50) || exit 0
url=$(target "$input") || exit 0
exec firefox "$url" >/dev/null 2>&1

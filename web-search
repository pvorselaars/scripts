#!/bin/bash
# Type a URL to open it, or anything else to search DuckDuckGo (so its !bangs work: "!yt lofi", "!gh sway").
# A leading "?" forces a search for things that look like URLs, e.g. "?main.py".
# `web-search --dry TEXT` prints the URL instead of opening it.

target() {
    local q=$1
    q=${q#"${q%%[![:space:]]*}"}; q=${q%"${q##*[![:space:]]}"}   # trim
    [ -n "$q" ] || return 1
    if [[ $q == \?* ]]; then
        q=${q#\?}; q=${q#"${q%%[![:space:]]*}"}
    elif [[ $q =~ ^[A-Za-z][A-Za-z0-9+.-]*:// ]]; then
        echo "$q"; return
    elif [[ $q =~ ^(localhost|[0-9]{1,3}(\.[0-9]{1,3}){3})(:[0-9]+)?([/?#]|$) ]]; then
        echo "http://$q"; return
    elif [[ $q =~ ^[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+(:[0-9]+)?([/?#]|$) ]] && [[ $q != *" "* ]]; then
        echo "https://$q"; return
    fi
    echo "https://duckduckgo.com/?q=$(printf '%s' "$q" | jq -sRr @uri)"
}

if [ "$1" = --dry ]; then
    target "$2"
    exit
fi

input=$(fuzzel --dmenu --prompt-only '󰖟 ' --width 50) || exit 0
url=$(target "$input") || exit 0
exec firefox "$url" >/dev/null 2>&1

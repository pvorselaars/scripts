#!/bin/bash
# screen-record [region|full]: start a recording, or stop the one that is running.
# Needs wf-recorder. Files go to ~/Videos/recordings. The bar shows REC while recording.
dir="$HOME/Videos/recordings"
refresh="$HOME/.local/bin/statusbar-refresh"

if pgrep -x wf-recorder >/dev/null; then
    pkill -INT -x wf-recorder      # lets it finish the file; the background job below then notifies
    exit 0
fi

command -v wf-recorder >/dev/null || { notify-send -u critical -a screen-record "wf-recorder is not installed"; exit 1; }
mkdir -p "$dir"
file="$dir/rec-$(date +%Y%m%d-%H%M%S).mp4"
args=()
case ${1:-region} in
    region) geometry=$(slurp) || exit 0; args=(-g "$geometry") ;;
    full) ;;
esac

# detached so it survives this script; announces the result when the recording ends
setsid -f bash -c '
    file=$1; refresh=$2; shift 2
    wf-recorder "$@" -f "$file" >/dev/null 2>&1
    notify-send -a screen-record "Recording saved" "$file"
    "$refresh"
' _ "$file" "$refresh" "${args[@]}"
sleep 0.5
notify-send -a screen-record -t 2000 "Recording started" "Press the same key again to stop"
"$refresh"

#!/bin/bash
# Searchable list of the sway keybindings, read from the config so it never goes stale.
# Shown in fuzzel; `keybindings-help --print` prints the list instead.
conf="$HOME/.config/sway/config"

declare -A var
while read -r _ name value; do var[${name#\$}]=$value; done < <(grep -E '^set \$[A-Za-z]+ ' "$conf")

expand() {   # replace $variables; multi-word ones (like $lock) are left alone
    local s=$1 k
    for k in "${!var[@]}"; do
        [[ ${var[$k]} == *" "* ]] || s=${s//\$$k/${var[$k]}}
    done
    echo "$s"
}

list() {
    local section="" line key cmd
    while IFS= read -r line; do
        case $line in
            '### '*) section=${line#\#\#\# }; section=${section%% (*}; section=${section%%:*} ;;
            bindsym\ *|bindgesture\ *)
                kind=${line%% *}; line=${line#* }
                while [[ $line == --* ]]; do line=${line#* }; done   # --locked, --release, ...
                key=${line%% *}; cmd=${line#* }
                key=$(expand "$key"); key=${key//Mod4/Super}; key=${key//Mod1/Alt}
                key=${key//question/?}; key=${key//grave/\`}; key=${key//minus/-}; key=${key//backslash/\\}
                key=${key//bracketleft/[}; key=${key//bracketright/]}
                [ "$kind" = bindgesture ] && key=${key//:/ }
                cmd=$(expand "$cmd"); cmd=${cmd//\~\/.local\/bin\//}; cmd=${cmd#exec }
                printf '%-26s %-48s %s\n' "$key" "${cmd:0:46}" "· $section"
                ;;
        esac
    done < "$conf"
}

if [ "$1" = --print ]; then
    list
else
    list | fuzzel --dmenu --prompt 'keys> ' --width 100 --lines 20 >/dev/null
fi

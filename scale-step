#!/bin/bash
# scale-step ±DELTA | reset: change the scale of the focused output (until the next sway reload)
# reset goes back to what the sway config sets: 1.5 on eDP-1, 1 elsewhere
out=$(swaymsg -t get_outputs -r | jq -r '.[] | select(.focused).name')
if [ "$1" = reset ]; then
    [ "$out" = eDP-1 ] && swaymsg output "$out" scale 1.5 || swaymsg output "$out" scale 1
    exit
fi
cur=$(swaymsg -t get_outputs -r | jq -r '.[] | select(.focused).scale')
new=$(awk -v c="$cur" -v d="$1" 'BEGIN { s = c + d; if (s < 0.5) s = 0.5; if (s > 3) s = 3; print s }')
swaymsg output "$out" scale "$new"

#!/bin/sh
# Lock the screen (swaylock-effects) over a blurred, dimmed snapshot of what was on it, with a clock.
# Does nothing if it is already locked, so triggers can overlap safely
# (idle timeout, sleep, loginctl lock-session, $mod+Escape).
# Colours: One Dark Darker, same as the sway config.
pgrep -x swaylock >/dev/null && exit 0
exec swaylock -f -c 1f2329 --screenshots \
    --effect-scale 0.25 --effect-blur 6x3 --effect-scale 4 --effect-vignette 0.2:0.9 \
    --fade-in 0.2 \
    --clock --timestr '%H:%M' --datestr '%A %-d %B' \
    --font "JetBrains Mono" --font-size 28 \
    --indicator --indicator-idle-visible --indicator-radius 90 --indicator-thickness 3 \
    --inside-color 00000000 --inside-clear-color 00000000 --inside-caps-lock-color 00000000 \
    --inside-ver-color 00000000 --inside-wrong-color 00000000 \
    --ring-color 30363f --ring-clear-color e5c07b --ring-caps-lock-color e5c07b \
    --ring-ver-color 4fa6ed --ring-wrong-color e55561 \
    --key-hl-color 4fa6ed --bs-hl-color e55561 --caps-lock-key-hl-color e5c07b --caps-lock-bs-hl-color e55561 \
    --line-color 00000000 --line-clear-color 00000000 --line-ver-color 00000000 --line-wrong-color 00000000 \
    --separator-color 00000000 \
    --text-color a0a8b7 --text-clear-color e5c07b --text-caps-lock-color e5c07b \
    --text-ver-color 4fa6ed --text-wrong-color e55561

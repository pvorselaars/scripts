#!/bin/sh
# lock-screen: lock the screen with a blurred, darkened snapshot of what was on it.
# Does nothing if it is already locked, so triggers can overlap safely (idle timeout, sleep,
# loginctl lock-session, $mod+Escape).
# Colours: One Dark Darker, same as the sway config. The ring only appears while typing.
pgrep -x swaylock >/dev/null && exit 0

dir=${XDG_RUNTIME_DIR:-/tmp}/lock-screen
mkdir -p "$dir"

# snapshot OUTPUT: save a blurred, darkened picture of the output as $dir/OUTPUT.png (fails if it cannot)
snapshot() {
    image="$dir/$1.png"
    # grab at a quarter of the size: blurring that is fast, and scaled back up it is smooth anyway
    grim -s 0.25 -o "$1" "$image" 2>/dev/null &&
        magick "$image" -virtual-pixel edge -blur 0x4 -modulate 55,80 \
            -fill '#1f2329' -colorize 25% -resize 400% "$image" 2>/dev/null
}

# one "-i OUTPUT:FILE" per active output that could be captured
images=""
for out in $(swaymsg -t get_outputs -r | jq -r '.[] | select(.active) | .name'); do
    if snapshot "$out"; then
        images="$images -i $out:$dir/$out.png"
    fi
done

# The indicator is a ring only: the inside and the lines are transparent (00000000).
# ring = idle/typing, -clear = cleared, -caps-lock, -ver = verifying, -wrong = wrong password.
# shellcheck disable=SC2086   # $images holds several words on purpose
exec swaylock -f -c 1f2329 $images --scaling fill \
    --font "JetBrains Mono" --font-size 22 --indicator-radius 70 --indicator-thickness 4 \
    --inside-color 00000000 --inside-clear-color 00000000 --inside-caps-lock-color 00000000 \
    --inside-ver-color 00000000 --inside-wrong-color 00000000 \
    --ring-color 30363f --ring-clear-color e5c07b --ring-caps-lock-color e5c07b \
    --ring-ver-color 4fa6ed --ring-wrong-color e55561 \
    --key-hl-color 4fa6ed --bs-hl-color e55561 --caps-lock-key-hl-color e5c07b --caps-lock-bs-hl-color e55561 \
    --line-color 00000000 --line-clear-color 00000000 --line-ver-color 00000000 --line-wrong-color 00000000 \
    --separator-color 00000000 \
    --text-color a0a8b7 --text-clear-color e5c07b --text-caps-lock-color e5c07b \
    --text-ver-color 4fa6ed --text-wrong-color e55561

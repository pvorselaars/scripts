#!/bin/bash
# bluetooth-menu: Bluetooth menu in fuzzel (bluetoothctl). Connect or disconnect known devices,
# pair new ones, turn the radio off. `bluetooth-menu --print` lists the entries without the menu.

POWER_ON="󰂯 Power on"

menu() { fuzzel --dmenu --index --prompt "$1" --width 48 --lines 12; }
say() { notify-send -a bluetooth "$@"; }

# --- the radio is off: the only thing to offer is turning it on
powered=$(bluetoothctl show | awk '/Powered:/ {print $2}')
if [ "$powered" != yes ]; then
    if [ "$1" = --print ]; then
        echo "$POWER_ON"
    elif [ "$(printf '%s\n' "$POWER_ON" | menu 'bluetooth> ')" = 0 ]; then
        bluetoothctl power on >/dev/null && say "Bluetooth on"
    fi
    exit 0
fi

entries=()   # what the menu shows
actions=()   # what picking an entry does, at the same index
add() { entries+=("$1"); actions+=("$2"); }

# Devices come as "MAC|name", listed connected first, then paired, then newly discovered.
add_devices() {
    local connected=() paired=() new=()
    local mac name info device

    while read -r _ mac name; do
        info=$(bluetoothctl info "$mac" 2>/dev/null)
        if grep -q 'Connected: yes' <<< "$info"; then
            connected+=("$mac|$name")
        elif grep -q 'Paired: yes' <<< "$info"; then
            paired+=("$mac|$name")
        else
            new+=("$mac|$name")
        fi
    done < <(bluetoothctl devices)

    for device in "${connected[@]}"; do add "󰂱 ${device#*|}  (connected)" "disconnect:${device%%|*}"; done
    for device in "${paired[@]}";    do add "󰂯 ${device#*|}" "connect:${device%%|*}"; done
    for device in "${new[@]}";       do add "󰂳 ${device#*|}  (new)" "pair:${device%%|*}"; done
}

connect_device() {
    if bluetoothctl connect "$1" >/dev/null 2>&1; then
        say "Connected"
    else
        say -u critical "Could not connect"
    fi
}

# pairing also marks the device as trusted, so it reconnects by itself later
pair_device() {
    local mac=$1
    # With pairable mode off, bluez pairs without a bond: the device connects once, but the laptop
    # keeps no link key, so it never reconnects by itself.
    bluetoothctl pairable on >/dev/null 2>&1
    if bluetoothctl pair "$mac" >/dev/null 2>&1 &&
       bluetoothctl trust "$mac" >/dev/null 2>&1 &&
       bluetoothctl connect "$mac" >/dev/null 2>&1; then
        if bluetoothctl info "$mac" | grep -q 'Bonded: yes'; then
            say "Paired and connected"
        else
            say -u critical "Connected, but not bonded" "It will not reconnect by itself. Try pairing again."
        fi
    else
        say -u critical "Could not pair"
    fi
}

add "󰂲 Power off" off
add "󰑓 Scan for new devices (8s)" scan
add_devices

if [ "$1" = --print ]; then
    printf '%s\n' "${entries[@]}"
    exit 0
fi

choice=$(printf '%s\n' "${entries[@]}" | menu 'bluetooth> ') || exit 0
action=${actions[$choice]}
mac=${action#*:}     # the part after the first colon; only used by the device actions

case $action in
    off)
        bluetoothctl power off >/dev/null && say "Bluetooth off"
        ;;
    scan)
        say "Scanning for 8 seconds"
        bluetoothctl --timeout 8 scan on >/dev/null 2>&1
        exec "$0"
        ;;
    disconnect:*) bluetoothctl disconnect "$mac" >/dev/null && say "Disconnected" ;;
    connect:*)    connect_device "$mac" ;;
    pair:*)       pair_device "$mac" ;;
esac

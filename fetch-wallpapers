#!/usr/bin/env bash
# Fetch SpaceX and APOD wallpapers into ~/Pictures/Wallpapers.
# Usage: fetch-wallpapers [count-per-source]   (default 15)
set -u
DIR="$HOME/Pictures/Wallpapers"
N="${1:-15}"
UA="Mozilla/5.0 fetch-wallpapers"
mkdir -p "$DIR"

dl() { # url dest
    [ -s "$2" ] && return 0
    curl -fsSL -m 60 -A "$UA" -o "$2.part" "$1" && mv "$2.part" "$2" && echo "  + $(basename "$2")"
    rm -f "$2.part"
}

wallhaven() { # prefix query sorting
    echo "[$1]"
    curl -fsS -m 20 -A "$UA" \
        "https://wallhaven.cc/api/v1/search?q=$2&categories=100&purity=100&atleast=1920x1080&ratios=16x9,16x10,3x2&sorting=$3" |
        jq -r --argjson n "$N" '.data[:$n][] | .path' |
        while read -r url; do dl "$url" "$DIR/$1-$(basename "$url")"; sleep 0.5; done
}

apod() {
    echo "[apod]"
    # APOD lives on science.nasa.gov as WordPress "image-article" posts; the old JSON API is unreliable
    curl -fsSL -m 30 -A "$UA" \
        "https://science.nasa.gov/wp-json/wp/v2/image-article?search=apod&orderby=date&order=desc&per_page=$((N * 2))&_fields=slug,featured_image_url" |
        jq -r '.[] | select(.slug | startswith("apod-")) | select(.featured_image_url != "") | "\(.slug) \(.featured_image_url | split("?")[0])"' |
        head -n "$N" |
        while read -r slug url; do
            dl "$url?w=2880&fit=clip" "$DIR/$slug.${url##*.}"
            sleep 0.5
        done
}

wallhaven spacex  "spacex"       relevance
apod

# drop broken downloads
find "$DIR" -type f \( -name "spacex-*" -o -name "apod-*" \) -size -20k -delete
echo "done: $(find "$DIR" -type f | wc -l) wallpapers in $DIR"

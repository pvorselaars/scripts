#!/usr/bin/env bash
# Download the curated wallpapers listed in wallpapers.txt into ~/Pictures/Wallpapers.
# Usage: fetch-wallpapers
# Images are scaled down to at most 3840 px wide; existing files are skipped.
set -u
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
DIR="$HOME/Pictures/Wallpapers"
LIST="$here/wallpapers.txt"
UA="Mozilla/5.0 fetch-wallpapers"
mkdir -p "$DIR"

grep -v '^#' "$LIST" | while read -r id _; do
    out="$DIR/$id.jpg"
    [ -s "$out" ] && continue
    # the API gives the real file path (and extension) for an id
    url=$(curl -fsS -m 20 -A "$UA" "https://wallhaven.cc/api/v1/w/$id" | jq -r '.data.path') || { echo "  ! $id: lookup failed"; continue; }
    tmp=$(mktemp "$DIR/.part-XXXXXX")
    if curl -fsSL -m 120 -A "$UA" -o "$tmp" "$url" && file -b --mime-type "$tmp" | grep -q '^image/'; then
        magick "$tmp" -resize '3840x>' -quality 90 "$out" && echo "  + $id"
    else
        echo "  ! $id: download failed"
    fi
    rm -f "$tmp"
    sleep 0.5
done
echo "done: $(find "$DIR" -maxdepth 1 -type f | wc -l) wallpapers in $DIR"

#!/bin/bash
# Pick a Firefox bookmark in fuzzel and open it. `bookmarks --print` lists them instead.
# Uses the most recently active profile; set FIREFOX_PROFILE to a profile directory to override.
list() {
python3 -I - "${FIREFOX_PROFILE:-}" <<'PY'
import glob, os, shutil, sqlite3, sys, tempfile
profile = sys.argv[1]
if not profile:
    dbs = glob.glob(os.path.expanduser("~/.config/mozilla/firefox/*/places.sqlite")) + \
          glob.glob(os.path.expanduser("~/.mozilla/firefox/*/places.sqlite"))
    if not dbs:
        sys.exit(0)
    newest = lambda d: max(os.path.getmtime(f) for f in (d, d + "-wal") if os.path.exists(f))
    profile = os.path.dirname(max(dbs, key=newest))
src = os.path.join(profile, "places.sqlite")
tmp = tempfile.mkdtemp()
try:
    for ext in ("", "-wal"):                    # copy: the live database is locked by Firefox
        if os.path.exists(src + ext):
            shutil.copy(src + ext, os.path.join(tmp, "places.sqlite" + ext))
    con = sqlite3.connect(os.path.join(tmp, "places.sqlite"))
    rows = con.execute("""SELECT b.title, p.url FROM moz_bookmarks b JOIN moz_places p ON b.fk = p.id
                          WHERE b.type = 1 AND p.url NOT LIKE 'place:%' ORDER BY b.title COLLATE NOCASE""").fetchall()
finally:
    shutil.rmtree(tmp, ignore_errors=True)
seen = set()
for title, url in rows:
    if url in seen:
        continue
    seen.add(url)
    title = (title or url).replace("\t", " ")
    print(f"{title[:60]}\t{url}")
PY
}

if [ "$1" = --print ]; then list | tr '\t' ' '; exit 0; fi
choice=$(list | awk -F'\t' '{printf "%-62s %s\n", $1, $2}' | fuzzel --dmenu --prompt 'bookmark> ' --width 110 --lines 15) || exit 0
url=${choice##* }
exec firefox "$url" >/dev/null 2>&1

#!/bin/bash
# statusbar: swaybar status line.
#
# Modules that only matter sometimes stay hidden until they do:
#   - REC while recording, a presentation icon in presentation mode, do-not-disturb
#   - the microphone, the camera or a screen share, while one of them is in use (see `privacy-status`)
#   - the playing track
#   - cpu, ram and disk when high; battery when low
#   - brightness and volume for a few seconds after a change
#   - a power profile icon, unless it is balanced
#   - Azure DevOps: pull requests waiting for you and failed runs of yours (see `ado`)
#   - network when there is traffic, bluetooth while a device is connected
#   - wifi only while offline
# Send SIGUSR1 (see statusbar-refresh) to redraw immediately.
# `statusbar-refresh all` shows every module for a few seconds (toggle).
#
# Modules set $res instead of printing, so they can keep state between refreshes.
# Thresholds can be overridden from the environment; for disk and net, 0 means always show.

: "${IDLE:=10}"          # seconds between refreshes
: "${SHOW_CHANGE:=3}"    # seconds to show brightness/volume after they change
: "${CPU_HIGH:=80}"      # percent
: "${MEM_HIGH:=85}"      # percent
: "${DISK_HIGH:=85}"     # percent used on /
: "${BAT_LOW:=20}"       # percent
: "${NET_MIN:=50}"       # KiB/s, down or up
: "${MEDIA_MAX:=40}"     # characters of "artist - title" to show

export LC_ALL=C.UTF-8   # so the track title is cut on characters, not bytes
shopt -u patsub_replacement 2>/dev/null   # bash 5.2: '&' in a ${var//a/b} replacement would mean "the match"

# Colours: One Dark Darker, same as ~/.config/sway/config. Needs `pango_markup enabled` in the bar.
RED='#e55561'
ORANGE='#f0a45d'
GREEN='#8ebd6b'
YELLOW='#e2b86b'
BLUE='#4fa6ed'
CYAN='#48b0bd'
PURPLE='#bf68d9'
DIM='#7a818e'

# The gap between modules is a span of its own: plain spaces between two icons are drawn
# from the symbols font, where a space is a dot.
GAP='<span font_family="JetBrains Mono">  </span>'

# markup-safe text -> $REPLY
esc() {
    REPLY=${1//&/&amp;}
    REPLY=${REPLY//</&lt;}
    REPLY=${REPLY//>/&gt;}
}

# paint COLOR TEXT -> $res
paint() { printf -v res '<span foreground="%s">%s</span>' "$1" "$2"; }

# --- state kept between refreshes ------------------------------------------------------------

showall_file="${XDG_RUNTIME_DIR:-/tmp}/statusbar.showall"   # holds the epoch time to stop showing everything
pidfile="${XDG_RUNTIME_DIR:-/tmp}/statusbar.pid"

poke=0
trap 'poke=1' USR1    # remembered, so a signal during a redraw is not lost

last_bright=""
bright_until=0
last_vol=""
vol_until=0
rx_rate=0
tx_rate=0

# --- lifecycle -------------------------------------------------------------------------------

echo $$ > "$pidfile"

# redraw when a player changes track or play state (playerctl blocks until something changes)
follower=""
if command -v playerctl >/dev/null; then
    { playerctl --all-players --follow metadata --format '{{status}} {{artist}} {{title}}' 2>/dev/null |
        while read -r _; do kill -USR1 $$ 2>/dev/null; done; } &
    follower=$!
fi

# remove our pidfile (unless a newer instance has taken it over) and stop the player watcher
cleanup() {
    [ "$(cat "$pidfile" 2>/dev/null)" = "$$" ] && rm -f "$pidfile"
    if [ -n "$follower" ]; then
        pkill -P "$follower" 2>/dev/null
        kill "$follower" 2>/dev/null
    fi
}
trap cleanup EXIT

# --- samples -----------------------------------------------------------------------------------

bright() { timeout 1 brightnessctl -c backlight -m 2>/dev/null | cut -d, -f4; }

# sets cur_total and cur_idle: cpu time since boot, all and idle
cpu_sample() {
    local _ user nice system idle iowait irq softirq steal
    read -r _ user nice system idle iowait irq softirq steal _ < /proc/stat
    cur_total=$((user + nice + system + idle + iowait + irq + softirq + steal))
    cur_idle=$((idle + iowait))
}

# sets net_rx, net_tx (bytes since boot, all real interfaces) and net_t (microseconds)
net_sample() {
    read -r net_rx net_tx < <(awk '
        /:/ {
            split($0, parts, ":")
            name = parts[1]; gsub(/ /, "", name)
            if (name !~ /^(lo|docker|veth|br-|virbr)/) {
                split(parts[2], fields, " ")
                rx += fields[1]; tx += fields[9]
            }
        }
        END { print rx + 0, tx + 0 }' /proc/net/dev)
    net_t=${EPOCHREALTIME/./}
}

last_bright=$(bright)
cpu_sample; prev_total=$cur_total; prev_idle=$cur_idle
net_sample; prev_rx=$net_rx; prev_tx=$net_tx; prev_t=$net_t

# bytes/s -> 0B / 12K / 1.4M
fmt_rate() {
    local rate=$1
    if [ "$rate" -ge 1048576 ]; then
        echo "$((rate * 10 / 1048576 / 10)).$((rate * 10 / 1048576 % 10))M"
    elif [ "$rate" -ge 1024 ]; then
        echo "$((rate / 1024))K"
    else
        echo "${rate}B"
    fi
}

# --- modules: each one sets $res, or leaves it empty to stay hidden ----------------------------

media() {
    local line status artist title text icon
    # one line per player: the first one that is playing wins; in all-mode a paused one is shown too
    line=$(timeout 1 playerctl --all-players metadata --format '{{status}}|{{artist}}|{{title}}' 2>/dev/null | grep -m1 '^Playing|')
    if [ -z "$line" ] && [ "$all" = 1 ]; then
        line=$(timeout 1 playerctl --all-players metadata --format '{{status}}|{{artist}}|{{title}}' 2>/dev/null | grep -m1 '^Paused|')
    fi
    [ -n "$line" ] || return

    status=${line%%|*}; line=${line#*|}
    artist=${line%%|*}; title=${line#*|}
    text=$title
    [ -n "$artist" ] && text="$artist - $title"
    [ "${#text}" -gt "$MEDIA_MAX" ] && text="${text:0:$((MEDIA_MAX - 1))}…"
    esc "$text"; text=$REPLY

    icon=󰎆
    [ "$status" = Paused ] && icon=󰏤
    paint "$ORANGE" "$icon $text"
}

rec() {
    pgrep -x wf-recorder >/dev/null && paint "$RED" "󰑊 REC"
}

pres() {
    [ -f "${XDG_RUNTIME_DIR:-/tmp}/presentation.mode" ] && paint "$ORANGE" "󰐨"
}

dnd() {
    timeout 1 makoctl mode 2>/dev/null | grep -q do-not-disturb && paint "$RED" "󰂛"
}

cpu() {
    local percent total_diff color
    cpu_sample
    total_diff=$((cur_total - prev_total))
    percent=0
    [ "$total_diff" -gt 0 ] && percent=$(( 100 * (total_diff - (cur_idle - prev_idle)) / total_diff ))
    prev_total=$cur_total
    prev_idle=$cur_idle

    if [ "$all" = 1 ] || [ "$percent" -ge "$CPU_HIGH" ]; then
        color=$CYAN
        [ "$percent" -ge "$CPU_HIGH" ] && color=$RED
        paint "$color" "󰍛 $percent%"
    fi
}

mem() {
    local percent color
    percent=$(awk '/MemTotal/ {t=$2} /MemAvailable/ {a=$2} END {printf "%d", 100 * (t - a) / t}' /proc/meminfo)

    if [ "$all" = 1 ] || [ "$percent" -ge "$MEM_HIGH" ]; then
        color=$PURPLE
        [ "$percent" -ge "$MEM_HIGH" ] && color=$RED
        paint "$color" "󰘚 $percent%"
    fi
}

# shown for SHOW_CHANGE seconds after the brightness changes
brightness() {
    local now current
    now=$(date +%s)
    current=$(bright)
    if [ -n "$current" ] && [ "$current" != "$last_bright" ]; then
        last_bright=$current
        bright_until=$((now + SHOW_CHANGE))
    fi

    if [ "$all" = 1 ] || [ "$now" -lt "$bright_until" ]; then
        paint "$YELLOW" "󰃟 $current"
    fi
}

disk() {
    local percent color
    percent=$(timeout 1 df --output=pcent / 2>/dev/null | tail -1 | tr -dc '0-9')
    [ -n "$percent" ] || return

    if [ "$all" = 1 ] || [ "$percent" -ge "$DISK_HIGH" ]; then
        color=$YELLOW
        [ "$percent" -ge "$DISK_HIGH" ] && color=$RED
        paint "$color" "󰋊 $percent%"
    fi
}

# measures rx_rate and tx_rate in bytes/s since the previous measurement
update_net_rates() {
    local elapsed
    net_sample
    elapsed=$((net_t - prev_t))

    # keep the previous rates if redraws come in too fast to measure
    if [ "$elapsed" -ge 500000 ]; then
        rx_rate=$(( (net_rx - prev_rx) * 1000000 / elapsed ))
        [ "$rx_rate" -lt 0 ] && rx_rate=0
        tx_rate=$(( (net_tx - prev_tx) * 1000000 / elapsed ))
        [ "$tx_rate" -lt 0 ] && tx_rate=0
        prev_rx=$net_rx
        prev_tx=$net_tx
        prev_t=$net_t
    fi
}

net() {
    local threshold=$((NET_MIN * 1024))
    update_net_rates

    if [ "$all" = 1 ] || [ "$rx_rate" -ge "$threshold" ] || [ "$tx_rate" -ge "$threshold" ]; then
        printf -v res '<span foreground="%s">󰇚 %s</span> <span foreground="%s">󰕒 %s</span>' \
            "$GREEN" "$(fmt_rate "$rx_rate")" "$BLUE" "$(fmt_rate "$tx_rate")"
    fi
}

profile() {
    local active
    active=$(busctl --system get-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile 2>/dev/null | cut -d'"' -f2)
    case $active in
        power-saver) paint "$GREEN" "󰌪" ;;
        performance) paint "$ORANGE" "󰓅" ;;
        balanced)    [ "$all" = 1 ] && paint "$DIM" "󰾅" ;;
    esac
}

battery() {
    local status percent color
    status=$("$HOME/Projects/scripts/battery") || return
    percent=${status##* }
    percent=${percent%\%}

    if [ "$all" = 1 ] || [ "$percent" -le "$BAT_LOW" ]; then
        color=$GREEN
        [ "$percent" -le 50 ] && color=$YELLOW
        [ "$percent" -le "$BAT_LOW" ] && color=$RED
        [[ $status == 󰂄* ]] && color=$GREEN    # charging
        paint "$color" "$status"
    fi
}

# privacy: an icon for each of the microphone, the camera and a screen share that is in use right now
# (see privacy-status). It only changes at a refresh, so it can lag by up to IDLE seconds.
privacy() {
    local kinds kind shown=() icon
    kinds=$("$HOME/Projects/scripts/privacy-status") || return
    for kind in $kinds; do
        case $kind in
            mic)    shown+=("<span foreground=\"$RED\">"$'\U000F036C'"</span>") ;;
            camera) shown+=("<span foreground=\"$RED\">"$'\U000F0100'"</span>") ;;
            screen) shown+=("<span foreground=\"$ORANGE\">"$'\U000F0379'"</span>") ;;
        esac
    done

    if [ "${#shown[@]}" -gt 0 ]; then
        res="${shown[0]}"
        for icon in "${shown[@]:1}"; do
            res+="$GAP$icon"        # not a plain space: that would be drawn as a dot between two icons
        done
    elif [ "$all" = 1 ]; then
        paint "$DIM" $'\U000F036C'
    fi
}

# Azure DevOps: pull requests waiting for your review (orange, red when one has waited too long), failed
# pipeline runs of yours (red) and open comments on your pull requests (blue).
# `ado refresh` writes the numbers every few minutes (a systemd timer); this module only reads them.
# A key means that az needs a new sign-in, or that the numbers have not been refreshed for a while.
devops() {
    local file="${XDG_RUNTIME_DIR:-/tmp}/ado/summary.json" error at review failed comments review_old shown=() part review_color=$ORANGE
    [ -r "$file" ] || return
    read -r error at review failed comments review_old < <(jq -r '[(.error // "-"), (.at // 0), (.review // 0), (.failed // 0), (.comments // 0), (.review_old // 0)] | join(" ")' "$file")
    [ "$review_old" -gt 0 ] && review_color=$RED        # a review has been waiting too long (NUDGE_REVIEW_HOURS in ado's config)

    if [ "$error" != "-" ] || [ $(( $(date +%s) - at )) -gt 1200 ]; then
        paint "$DIM" $'\U000F0306'      # key
        return
    fi
    [ "$review" -gt 0 ] && shown+=("<span foreground=\"$review_color\">"$'\U000F062C'" $review</span>")     # branch
    [ "$failed" -gt 0 ] && shown+=("<span foreground=\"$RED\">"$'\U000F0028'" $failed</span>")        # alert circle
    [ "$comments" -gt 0 ] && shown+=("<span foreground=\"$BLUE\">"$'\U000F0188'" $comments</span>")   # comment: open threads on your PRs

    if [ "${#shown[@]}" -gt 0 ]; then
        res="${shown[0]}"
        for part in "${shown[@]:1}"; do res+="$GAP$part"; done      # not a plain space: that would be drawn as a dot between two icons
    elif [ "$all" = 1 ]; then
        paint "$DIM" $'\U000F062C'" 0"
    fi
}

bluetooth() {
    local connected
    connected=$(timeout 1 bluetoothctl devices Connected 2>/dev/null | grep -c '^Device')
    if [ "$connected" -gt 0 ]; then
        paint "$BLUE" "󰂱 $connected"
    elif [ "$all" = 1 ]; then
        paint "$DIM" "󰂯"
    fi
}

wifi() {
    local ssid
    if timeout 1 nmcli -t -f TYPE,STATE device 2>/dev/null | grep -qE '^(wifi|ethernet):connected$'; then
        [ "$all" = 1 ] || return
        # --rescan no: listing otherwise waits for a fresh scan, which can block for many seconds
        ssid=$(timeout 1 nmcli -t -f ACTIVE,SSID device wifi list --rescan no 2>/dev/null | sed -n 's/^yes://p' | head -1)
        esc "$ssid"; ssid=$REPLY
        if [ -n "$ssid" ]; then
            paint "$GREEN" "󰖩 $ssid"
        else
            paint "$GREEN" "󰈀"       # connected without wifi: a cable
        fi
    else
        paint "$RED" "󰖪"
    fi
}

# shown for SHOW_CHANGE seconds after the volume or mute state changes
volume() {
    local out percent icon color current now
    out=$(timeout 1 wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null) || return
    percent=$(echo "$out" | awk '{printf "%d", $2 * 100}')

    color=$CYAN
    if [[ $out == *MUTED* ]]; then
        icon=󰝟
        color=$DIM
    elif [ "$percent" -lt 34 ]; then
        icon=󰕿
    elif [ "$percent" -lt 67 ]; then
        icon=󰖀
    else
        icon=󰕾
    fi

    current="$icon $percent%"
    now=$(date +%s)
    if [ "$current" != "$last_vol" ]; then
        [ -n "$last_vol" ] && vol_until=$((now + SHOW_CHANGE))
        last_vol=$current
    fi

    if [ "$all" = 1 ] || [ "$now" -lt "$vol_until" ]; then
        paint "$color" "$current"
    fi
}

# --- drawing -----------------------------------------------------------------------------------

# sets $all to 1 while "show everything" is on (`statusbar-refresh all` writes when it ends)
read_show_all() {
    all=0
    [ -f "$showall_file" ] || return
    if [ "$(date +%s)" -lt "$(cat "$showall_file")" ]; then
        all=1
    else
        rm -f "$showall_file"
    fi
}

# prints the whole status line: the modules that have something to show, then the clock
draw() {
    local parts=() module line part
    for module in rec privacy pres cpu mem disk net brightness bluetooth wifi volume dnd profile battery devops media; do
        res=""
        $module
        [ -n "$res" ] && parts+=("$res")
    done

    printf -v res '<span foreground="%s">󰃭</span> %s  <span foreground="%s">󰅐</span> %s' \
        "$DIM" "$(date '+%a %d %b')" "$DIM" "$(date '+%H:%M')"
    parts+=("$res")

    line=${parts[0]}
    for part in "${parts[@]:1}"; do
        line+="$GAP$part"
    done
    printf '%s\n' "$line"
}

# seconds until the next refresh: quick while something temporary is on screen, so it goes away on time
refresh_delay() {
    local now
    now=$(date +%s)
    if [ "$all" = 1 ] || [ "$now" -lt "$bright_until" ] || [ "$now" -lt "$vol_until" ]; then
        echo 1
    else
        echo "$IDLE"
    fi
}

# sleep in 1 second steps: a signal ends the sleep early, and nothing can slip in between the check and the sleep
wait_for_refresh() {
    local delay=$1 step sleeper
    for ((step = 0; step < delay && poke == 0; step++)); do
        sleep 1 & sleeper=$!
        wait "$sleeper"
        kill "$sleeper" 2>/dev/null
    done
}

while :; do
    echo $$ > "$pidfile"    # self-heal: another instance's exit (e.g. a reload) may have removed it
    poke=0
    read_show_all
    draw

    # a signal arrived while we were drawing: draw again right away
    [ "$poke" = 1 ] && continue

    wait_for_refresh "$(refresh_delay)"
done
